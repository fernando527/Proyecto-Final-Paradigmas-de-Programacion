@{
    ViewData["Title"] = "Inicio de Sesión";
}


<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-5">

            <h2 class="text-center mb-4">
                Inicio de Sesión
            </h2>


            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }



            <form asp-action="Login" method="post">


                <div class="mb-3">

                    <label class="form-label">
                        Correo
                    </label>


                    <input type="email"
                           name="correo"
                           class="form-control"
                           placeholder="Ingrese su correo"
                           required />

                </div>



                <div class="mb-3">

                    <label class="form-label">
                        Contraseña
                    </label>


                    <input type="password"
                           name="contrasena"
                           class="form-control"
                           placeholder="Ingrese su contraseña"
                           required />

                </div>



                <button type="submit"
                        class="btn btn-primary w-100">

                    Ingresar

                </button>

                <p class="mt-3">

                    ¿No tienes una cuenta?

                    <a asp-controller="Usuarios"
                           asp-action="CrearCuenta">

                        Crear cuenta

                    </a>

                </p>


            </form>


        </div>

    </div>

</div>