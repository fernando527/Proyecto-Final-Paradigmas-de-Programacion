@{
    ViewData["Title"] = "Inicio";
}


<div class="container mt-5">


    <div class="text-center">

        <h1 class="display-4 fw-bold text-primary">
            Sistema de Reporte de Daños en Aulas
        </h1>


        <h3 class="text-secondary">
            UNAH Valle de Sula
        </h3>


        <hr />


        <p class="lead">
            Este sistema permite registrar y dar seguimiento a los daños
            reportados en las aulas de la UNAH-VS, facilitando la comunicación
            entre los usuarios y el personal encargado del mantenimiento.
        </p>


    </div>



    <div class="row mt-5">



        <!-- Registrar Reporte -->

        <div class="col-md-6 col-lg-4 mb-4">


            <div class="card shadow h-100">


                <div class="card-body text-center">


                    <h4>
                        Registrar Reporte
                    </h4>


                    <p>
                        Registrar un nuevo daño detectado en un aula.
                    </p>


                    <a asp-controller="Reportes"
                           asp-action="Crear"
                           class="btn btn-primary">


                        Registrar


                    </a>


                </div>


            </div>


        </div>





        <!-- Ver reportes / Mis reportes -->


        <div class="col-md-6 col-lg-4 mb-4">


            <div class="card shadow h-100">


                <div class="card-body text-center">


                    @if (Context.Session.GetString("Rol") == "Administrador")
                    {


                        <h4>
                            Ver Reportes
                        </h4>


                        <p>
                            Consultar los reportes registrados.
                        </p>


                        <a asp-controller="Reportes"
                               asp-action="Index"
                               class="btn btn-success">


                            Ver Reportes


                        </a>


                    }
                    else
                    {


                        <h4>
                            Mis Reportes
                        </h4>


                        <p>
                            Consultar los reportes que usted ha registrado.
                        </p>


                        <a asp-controller="Reportes"
                               asp-action="MisReportes"
                               class="btn btn-success">


                            Mis Reportes


                        </a>


                    }


                </div>


            </div>


        </div>





        <!-- Investigación -->


        <div class="col-md-6 col-lg-4 mb-4">


            <div class="card shadow h-100">


                <div class="card-body text-center">


                    <h4>
                        Investigación
                    </h4>


                    <p>
                        Información sobre el problema y la solución propuesta.
                    </p>


                    <a asp-controller="Home"
                           asp-action="AcercaDelSistema"
                           class="btn btn-primary">


                        Acerca del Sistema


                    </a>


                </div>


            </div>


        </div>





        <!-- Administración -->
        @if (Context.Session.GetString("Rol") == "Administrador")
        {


            <div class="col-md-6 col-lg-4 mb-4">


                <div class="card shadow h-100">


                    <div class="card-body text-center">


                        <h4>
                            Administración
                        </h4>


                        <p>
                            Gestionar estados de los reportes.
                        </p>


                        <a asp-controller="Administracion"
                               asp-action="Index"
                               class="btn btn-danger">


                            Administrar Reportes


                        </a>




                    </div>


                </div>


            </div>


            <div class="col-md-6 col-lg-4 mb-4">


                <div class="card shadow h-100">


                    <div class="card-body text-center">


                        <h4>
                            Dashboard
                        </h4>


                        <p>
                            Un Conteo de los reportes existentes.
                        </p>


                        <a asp-controller="Administracion"
                               asp-action="Dashboard"
                               class="btn btn-dark mt-2">

                            Dashboard

                        </a>




                    </div>


                </div>


            </div>


        }



    </div>


</div>